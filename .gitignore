# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

.vscode

# Local secrets and tokens
config.yaml
data/athlete.json
.garmin_cn_tokens/

# Runtime data generated by local analysis/sync.
# Some historical sample files are already tracked; these rules prevent new
# generated artifacts from being added accidentally.
data/activity_index.json
data/activity_history.jsonl
data/summaries/*.summary.json
log/*.jsonl
log/*.md
garmin_cn_fit_files/*.fit

# Scratch/demo outputs
demo/onelap_downloads/
demo/codoon_uploads/
test.json
figure.png
todo.md
